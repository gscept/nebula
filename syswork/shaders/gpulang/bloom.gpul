#include <lib/shared.gpuh>

const KernelSize = 16;
sampler_state InputSampler
{
    Filter = FilterMode.Linear;
    AddressU = AddressMode.Mirror;
    AddressV = AddressMode.Mirror;
};

struct BloomData
{
    Mips : i32;
    Resolutions : [14]f32x4;
};
uniform BloomUniforms : *BloomData;

uniform Input : *texture2D;
uniform BloomOutput : *mutable rgba16f texture2D;
uniform Intermediate : *texture2D;
uniform BloomIntermediate : [14]*mutable rgba16f texture2D;

workgroup SampleLookup : [KernelSize][KernelSize]f32x3;

//------------------------------------------------------------------------------
/**
*/
LoadLDS(pixel : i32x2) f32x3
{
    return SampleLookup[pixel.x][pixel.y];
}

//------------------------------------------------------------------------------
/**
    3x3 tent (1-2-1 / 2-4-2 / 1-2-1) in mip-pixel space.
*/
SampleTentUpscale(center : i32x2) f32x3
{
    const a = LoadLDS(center + i32x2(-1, 1));
    const b = LoadLDS(center + i32x2(0, 1));
    const c = LoadLDS(center + i32x2(1, 1));

    const d = LoadLDS(center + i32x2(-1, 0));
    const e = LoadLDS(center + i32x2(0, 0));
    const f = LoadLDS(center + i32x2(1, 0));

    const g = LoadLDS(center + i32x2(-1, -1));
    const h = LoadLDS(center + i32x2(0, -1));
    const i = LoadLDS(center + i32x2(1, -1));

    var res = e * 4.0f;
    res += (b + d + f + h) * 2.0f;
    res += (a + c + g + i);
    return res / 16.0f;
}

//------------------------------------------------------------------------------
/**
*/
local_size_x(KernelSize)
local_size_y(KernelSize)
local_size_z(1)
entry_point
csUpscale() void
{
    const threadIndex = computeGetLocalThreadIndices().xy;
    const groupIndex = computeGetWorkgroupIndices();
    const mip = i32(computeGetNumWorkgroups().z) - 1;
    if (groupIndex.z != 0)
    {
        return;
    }

    const tileStart = groupIndex.xy * (KernelSize - 2);
    const tileEnd = tileStart + u32x2(KernelSize - 2);

    const outputPixel = tileStart + threadIndex;
    const sampleCoord = i32x2(tileStart) + i32x2(threadIndex) - i32x2(1);

    const tileEndClamped = min(tileEnd, u32x2(BloomUniforms.Resolutions[mip].xy));

    const pixelOutputMask = all(outputPixel < tileEndClamped);
    const vp = i32x2(BloomUniforms.Resolutions[mip].xy);
    var samp = f32x3(0);
    if (all(sampleCoord >= i32x2(0)) && all(sampleCoord < vp))
    {
        const sampleUV = (f32x2(sampleCoord) + f32x2(0.5f)) * BloomUniforms.Resolutions[mip].zw;
        samp = textureSampleLod(Input, InputSampler, sampleUV, f32(mip)).rgb;
    }

    const weights : [14] f32 = [ 0.3465, 0.138, 0.1176, 0.066, 0.066, 0.061, 0.061, 0.055, 0.055, 0.050, 0.050, 0.045, 0.045, 0.040 ];

    SampleLookup[threadIndex.x][threadIndex.y] = samp;
    executionBarrierWorkgroup();

    if (pixelOutputMask)
    {
        var sum = SampleTentUpscale(i32x2(threadIndex) + i32x2(1)) * weights[mip];
        if (mip < BloomUniforms.Mips - 1)
        {
            const uv = (f32x2(outputPixel) + f32x2(0.5f)) * BloomUniforms.Resolutions[mip].zw;
            const halfpixel = BloomUniforms.Resolutions[mip].zw * 0.5f;
            const lod = f32(mip + 1);
            const uvMin = BloomUniforms.Resolutions[mip + 1].zw * 0.5f;
            const uvMax = BloomUniforms.Resolutions[mip + 1].xy * BloomUniforms.Resolutions[mip + 1].zw - uvMin;

            const tapOffsets : [8]f32x2 = [
                f32x2(-halfpixel.x * 2.0f, 0),
                f32x2(-halfpixel.x, halfpixel.y),
                f32x2(0, halfpixel.y * 2.0f),
                f32x2(halfpixel.x, halfpixel.y),
                f32x2(halfpixel.x * 2.0f, 0),
                f32x2(halfpixel.x, -halfpixel.y),
                f32x2(0, -halfpixel.y * 2.0f),
                f32x2(-halfpixel.x, -halfpixel.y)
            ];
            const tapWeights : [8]f32 = [ 1.0f, 2.0f, 1.0f, 2.0f, 1.0f, 2.0f, 1.0f, 2.0f ];

            var up = f32x3(0);
            for (var t : i32 = 0; t < 8; t++)
            {
                const tap = uv + tapOffsets[t];
                if (all(tap >= uvMin) && all(tap <= uvMax))
                {
                    up += textureSampleLod(Intermediate, InputSampler, tap, lod).rgb * tapWeights[t];
                }
            }
            sum += up / 12.0f;
        }
        textureStore(BloomIntermediate[mip], i32x2(outputPixel.x, outputPixel.y), f32x4(sum, 0));
    }
}

//------------------------------------------------------------------------------
/**
*/
local_size_x(256)
entry_point
csMerge() void
{
    const threadIndex = computeGetLocalThreadIndices().xy;
    const groupIndex = computeGetWorkgroupIndices();

    const tileStart = u32x2(groupIndex.x * 256, groupIndex.y);
    const tileEnd = tileStart + u32x2(256, 1);

    const outputPixel = tileStart + threadIndex.xy;

    const tileEndClamped = min(tileEnd, u32x2(BloomUniforms.Resolutions[0].xy));

    const pixelOutputMask = all(outputPixel < tileEndClamped);
    const uv = (f32x2(outputPixel) + f32x2(0.5f)) * BloomUniforms.Resolutions[0].zw;
    const sum = textureSampleLod(Intermediate, InputSampler, uv, 0).rgb;

    if (pixelOutputMask)
    {
        const weight = sum / f32(BloomUniforms.Mips);
        textureStore(BloomOutput, i32x2(outputPixel.x, outputPixel.y), f32x4(sum, saturate(dot(weight, weight)) * PerTickParams.BloomIntensity));
    }
}

//------------------------------------------------------------------------------
/**
*/
@Mask("Intermediate")
program Bloom
{
    ComputeShader = csUpscale;
};

@Mask("Merge")
program BloomMerge
{
    ComputeShader = csMerge;
};

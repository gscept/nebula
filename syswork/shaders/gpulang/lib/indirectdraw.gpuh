// struct defined by the Vulkan spec
alignas(4)
struct DrawCommand
{
    vertexCount : u32;
    instanceCount : u32;
    startVertex : u32;
    startInstance : u32;
};

alignas(4)
struct DrawIndexedCommand
{
    indexCount : u32;
    instanceCount : u32;
    startIndex : u32;
    offsetVertex : u32;
    startInstance : u32;
};

struct VegetationInstance
{
    position : f32x3;
    materialIndex : u32;
	rotation : f32x4;		// rotation as a quaternion
    random : f32;			// use for wind sway
    lodFlags : u32;
};
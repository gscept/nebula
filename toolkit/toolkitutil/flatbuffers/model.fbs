include "foundation/math.fbs";
include "scene.fbs";
include "mesh.fbs";
include "skeleton.fbs";
include "anim.fbs";
include "physics.fbs";
namespace ToolkitUtil;

enum OptimizationFlags : uint
{
	None = 0x0,
	RemoveRedundantVertices = 0x1,
	CalculateNormals = 0x2,
	FlipUVs = 0x4,
	CalculateTangentFrame = 0x8,
	CalculateRigidSkinning = 0x10,
	MergeNodesWithSharedMaterial = 0x20,
	ImportVertexColors = 0x40,
	ImportSecondaryUVs = 0x80
}

table ModelAsset
{
	scene : SceneResource;
	mesh : MeshResource;
	skeleton : SkeletonResource;
	animation : AnimResource;
	physics : PhysicsResource;
	flags : OptimizationFlags;
	// the file the asset was imported from, src: relative when it's in the project, which reimporting imports again
	source : string;
	// the import scale, the factor the source units are multiplied with to get meters
	scale : float = 1.0;
	// parts of the animation clips packaged as clips of their own, for sources without a take per clip. They're
	// stored apart from the animation, so reimporting keeps them
	clip_sections : [AnimClipSection];
	// events added to the clips and the clip sections when they're packaged, stored apart from the animation as well
	clip_events : [AnimClipEvent];
}

root_type ModelAsset;
file_identifier "MOAS";
file_extension "nasset";
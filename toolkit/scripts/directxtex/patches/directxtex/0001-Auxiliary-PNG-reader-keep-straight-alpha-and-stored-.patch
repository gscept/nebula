From 5b67a3abf2690b28e93c60cc3e8810ea980ccbb8 Mon Sep 17 00:00:00 2001
From: Johannes <johannes.hirche@gmail.com>
Date: Sat, 31 Oct 2026 17:21:12 +0100
Subject: [PATCH] Auxiliary PNG reader: keep straight alpha and stored values

png_set_alpha_mode(PNG_ALPHA_STANDARD, PNG_GAMMA_LINEAR) made libpng
premultiply the colors by alpha and convert files with an sRGB or gAMA
chunk to linear, while the image is still reported with the format the
chunks select (e.g. R8G8B8A8_UNORM_SRGB). The WIC loader returns the
stored values with straight alpha, so the same PNG converted differently
on Windows and with the libpng reader.

Drop the alpha mode and gamma requests, the chunks are still used to
pick the sRGB or linear DXGI format.
---
 Auxiliary/DirectXTexPNG.cpp | 20 ++++----------------
 1 file changed, 4 insertions(+), 16 deletions(-)

diff --git a/Auxiliary/DirectXTexPNG.cpp b/Auxiliary/DirectXTexPNG.cpp
index 8b242f4..808f803 100644
--- a/Auxiliary/DirectXTexPNG.cpp
+++ b/Auxiliary/DirectXTexPNG.cpp
@@ -152,22 +152,10 @@ namespace
                 png_set_swap(st);
             }
 
-            // Request libpng the alpha change, but keep RGB untouched.
-            png_set_alpha_mode(st, PNG_ALPHA_STANDARD, PNG_GAMMA_LINEAR);
-
-            // Deal with custom color profiles
-            if( png_get_valid( st, info, PNG_INFO_gAMA ) )
-            {
-                double gamma = 0;
-                double screen_gamma = 2.2;
-
-                if( png_get_gAMA( st, info, &gamma ) )
-                {
-                    // If gamma == 1.0, then the data is internally linear.
-                    if( abs( gamma - 1.0 ) > 1e-6 )
-                        png_set_gamma( st, screen_gamma, gamma );
-                }
-            }
+            // Keep the stored values like the WIC loader does: straight alpha and no gamma
+            // correction. PNG_ALPHA_STANDARD premultiplied the colors by alpha and the
+            // PNG_GAMMA_LINEAR output gamma linearized every file with an sRGB or gAMA chunk.
+            // These chunks only pick the DXGI format, see GuessFormat.
 
             // make 4 component
             // using `png_set_add_alpha` here may confuse `TEX_ALPHA_MODE_OPAQUE` estimation

From ab0c05ed9dc5f794ff8c1a6f63b3bfde110f622c Mon Sep 17 00:00:00 2001
From: Johannes <johannes.hirche@gmail.com>
Date: Sat, 31 Oct 2026 16:28:26 +0100
Subject: [PATCH 2/2] Install libjpeg-turbo to lib on every distro

The static libjpeg.a is expected in libjpeg-turbo-install/lib, but on
distros that use lib64 (RHEL, Fedora, openSUSE, ...) GNUInstallDirs puts
it into lib64 and linking texconv fails. Pin the install libdir.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 399df3e..aae4268 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -77,6 +77,7 @@ if(ENABLE_LIBJPEG_SUPPORT)
             GIT_TAG 3.1.3
             CMAKE_ARGS
                 -DCMAKE_INSTALL_PREFIX=${JPEG_INSTALL_PREFIX}
+                -DCMAKE_INSTALL_LIBDIR=lib
                 -DENABLE_SHARED=OFF
                 -DENABLE_STATIC=ON
                 -DCMAKE_POSITION_INDEPENDENT_CODE=ON

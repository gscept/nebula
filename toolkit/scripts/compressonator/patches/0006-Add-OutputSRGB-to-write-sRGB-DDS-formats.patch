 applications/_plugins/cimage/dds/dds_dx10.cpp | 36 +++++++++++++++++++
 .../_plugins/cimage/dds/dds_helpers.cpp       |  4 +--
 .../_plugins/cimage/dds/dds_helpers.h         |  1 +
 applications/_plugins/common/cmdline.cpp      |  5 +++
 applications/_plugins/common/textureio.cpp    |  4 +++
 .../source/compressonatorcli.cpp              |  2 ++
 cmp_compressonatorlib/compressonator.h        |  2 ++
 7 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/applications/_plugins/cimage/dds/dds_dx10.cpp b/applications/_plugins/cimage/dds/dds_dx10.cpp
index 76fb7f4..3a947fd 100644
--- a/applications/_plugins/cimage/dds/dds_dx10.cpp
+++ b/applications/_plugins/cimage/dds/dds_dx10.cpp
@@ -387,8 +387,44 @@ TC_PluginError LoadDDS_DX10_FourCC(FILE* pFile, DDSD2* pDDSD, MipSet* pMipSet, C
     return GenericLoadFunction(pFile, pDDSD, pMipSet, extra, CF_Compressed, TDT_XRGB, PreLoopFourCC, LoopFourCC, PostLoopFourCC);
 }
 
+static DXGI_FORMAT GetSRGBDXGIFormat(const MipSet* pMipSet)
+{
+    if (!(pMipSet->m_Flags & MS_FLAG_sRGB))
+        return DXGI_FORMAT_UNKNOWN;
+
+    switch (pMipSet->m_format)
+    {
+    case CMP_FORMAT_BC1:
+    case CMP_FORMAT_DXT1:
+        return DXGI_FORMAT_BC1_UNORM_SRGB;
+    case CMP_FORMAT_BC2:
+    case CMP_FORMAT_DXT3:
+        return DXGI_FORMAT_BC2_UNORM_SRGB;
+    case CMP_FORMAT_BC3:
+    case CMP_FORMAT_DXT5:
+        return DXGI_FORMAT_BC3_UNORM_SRGB;
+    case CMP_FORMAT_BC7:
+        return DXGI_FORMAT_BC7_UNORM_SRGB;
+    case CMP_FORMAT_RGBA_8888:
+    case CMP_FORMAT_ARGB_8888:
+        // 8-bit RGBA is stored as R, G, B, A in memory
+        return DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    default:
+        return DXGI_FORMAT_UNKNOWN;
+    }
+}
+
+bool IsSRGBDX10Format(const MipSet* pMipSet)
+{
+    return GetSRGBDXGIFormat(pMipSet) != DXGI_FORMAT_UNKNOWN;
+}
+
 DXGI_FORMAT GetDXGIFormat(const MipSet* pMipSet)
 {
+    DXGI_FORMAT srgbFormat = GetSRGBDXGIFormat(pMipSet);
+    if (srgbFormat != DXGI_FORMAT_UNKNOWN)
+        return srgbFormat;
+
     if (pMipSet->m_dwFourCC == CMP_FOURCC_DX10)
     {
         switch (pMipSet->m_format)
diff --git a/applications/_plugins/cimage/dds/dds_helpers.cpp b/applications/_plugins/cimage/dds/dds_helpers.cpp
index 0d7a26d..22a3bb9 100644
--- a/applications/_plugins/cimage/dds/dds_helpers.cpp
+++ b/applications/_plugins/cimage/dds/dds_helpers.cpp
@@ -65,8 +65,8 @@ bool IsD3D10Format(const MipSet* pMipSet)
 
     if (pMipSet->m_dwFourCC == CMP_FOURCC_DX10)
         return true;
-    else
-        return false;
+    // sRGB can only be expressed with a DX10 header
+    return IsSRGBDX10Format(pMipSet);
 }
 
 void DetermineTextureType(const DDSD2* pDDSD, MipSet* pMipSet)

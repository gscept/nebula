+cmake_minimum_required(VERSION 3.10)
+
+add_library(Image_TIFF STATIC "")
+
+target_sources(Image_TIFF
+    PRIVATE
+    ${PROJECT_SOURCE_DIR}/applications/_plugins/common/tc_pluginapi.h
+    ${PROJECT_SOURCE_DIR}/applications/_plugins/common/tc_plugininternal.h
+    ${PROJECT_SOURCE_DIR}/applications/_plugins/common/tc_plugininternal.cpp
+    ./cmp_tiff.cpp
+    ./cmp_tiff.h
+    )
+
+target_include_directories(Image_TIFF
+     PRIVATE
+     ${PROJECT_SOURCE_DIR}/cmp_compressonatorlib
+     ${PROJECT_SOURCE_DIR}/cmp_framework/common/half
+     ${PROJECT_SOURCE_DIR}/applications/_plugins/common
+     )
+
+# zlib is linked explicitly for static builds of libtiff, which don't carry it along
+target_link_libraries(Image_TIFF PUBLIC TIFF::TIFF)
+if (ZLIB_FOUND)
+    target_link_libraries(Image_TIFF PUBLIC ZLIB::ZLIB)
+endif()
+if (UNIX)
+    target_link_libraries(Image_TIFF PUBLIC m)
+    target_compile_definitions(Image_TIFF PRIVATE _LINUX)
+endif()
+
+# users register the plugin only when it is actually built
+target_compile_definitions(Image_TIFF INTERFACE CMP_BUILD_TIFF_PLUGIN=1)
+
+set_target_properties(Image_TIFF PROPERTIES FOLDER ${PROJECT_FOLDER_SDK_PLUGIN_STATIC})

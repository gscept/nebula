    blockRGB[14] = NormalCacheResult[blockStart.x + 2][blockStart.y + 3];
    blockRGB[15] = NormalCacheResult[blockStart.x + 3][blockStart.y + 3];

    return CompressBC3Block(blockRGB, blockA, 1.0f);


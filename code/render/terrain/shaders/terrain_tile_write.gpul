    blockRGB[8] = NormalCacheResult[blockStart.x][blockStart.y + 2];
    blockRGB[9] = NormalCacheResult[blockStart.x + 1][blockStart.y + 2];
    blockRGB[10] = NormalCacheResult[blockStart.x + 2][blockStart.y + 2];

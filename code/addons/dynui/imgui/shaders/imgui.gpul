#include "lib/std.gpuh"
#include "lib/shared.gpuh"
#include "lib/defaultsamplers.gpuh"


struct ImGuiData
{
    TextProjectionModel : f32x4x4;
    ColorMask : u32;
    PackedTextureInfo : u32;
    RangeMin : f32;
    RangeMax : f32;
    Exposure : f32;
};

@Visibility("VS|PS")
inline ImGUI : *ImGuiData;

group(BATCH_GROUP) sampler_state TextureSampler
{
    Filter = FilterMode.Linear;
    AddressU = AddressMode.Clamp;
    AddressV = AddressMode.Clamp;
};

group(BATCH_GROUP) sampler_state PointTextureSampler
{
    Filter = FilterMode.Nearest;
    AddressU = AddressMode.Clamp;
    AddressV = AddressMode.Clamp;
};

render_state TextState
{
    BlendEnabled[0] = true;
    SourceBlend[0] = BlendFactor.SourceAlpha;
    DestinationBlend[0] = BlendFactor.OneMinusSourceAlpha;
    DepthWriteEnabled = false;
    DepthTestEnabled = false;
    Cull = CullFace.None;
    ScissorEnabled = true;
};

//------------------------------------------------------------------------------
/**
*/ 
UnpackTexture(val : u32, out id : u32, out type : u32, out mip : u32, out layer : u32, out useRange : u32, out useAlpha : u32, out splat : u32, out pointFilter : u32, out tonemap : u32) void
{
    const TEXTURE_TYPE_MASK = 0xFu;
    const TEXTURE_LAYER_MASK = 0xFFu;
    const TEXTURE_MIP_MASK = 0xFu;
    const TEXTURE_USE_RANGE_MASK = 0x1u;
    const TEXTURE_USE_ALPHA_MASK = 0x1u;
    const TEXTURE_SINGLE_CHANNEL = 0x1u;
    const TEXTURE_ID_MASK = 0x7FFu;
    const TEXTURE_POINT_FILTER_MASK = 0x1u;
    const TEXTURE_TONEMAP_MASK = 0x1u;

    type = val & TEXTURE_TYPE_MASK;
    layer = (val >> 4u) & TEXTURE_LAYER_MASK;
    mip = (val >> 12u) & TEXTURE_MIP_MASK;
    useRange = (val >> 16u) & TEXTURE_USE_RANGE_MASK;
    useAlpha = (val >> 17u) & TEXTURE_USE_ALPHA_MASK;
    splat = (val >> 18u) & TEXTURE_SINGLE_CHANNEL;
    id = (val >> 19u) & TEXTURE_ID_MASK;
    pointFilter = (val >> 30u) & TEXTURE_POINT_FILTER_MASK;
    tonemap = (val >> 31u) & TEXTURE_TONEMAP_MASK;
}

//------------------------------------------------------------------------------
/**
    Direction through a texel of a cube face, faces are ordered +X, -X, +Y, -Y, +Z, -Z
*/
CubeFaceDirection(uv : f32x2, face : u32) f32x3
{
    const s = uv.x * 2.0f - 1.0f;
    const t = uv.y * 2.0f - 1.0f;
    if face == 0u { return f32x3(1.0f, -t, -s); }
    else if face == 1u { return f32x3(-1.0f, -t, s); }
    else if face == 2u { return f32x3(s, 1.0f, t); }
    else if face == 3u { return f32x3(s, -1.0f, -t); }
    else if face == 4u { return f32x3(s, -t, 1.0f); }
    return f32x3(-s, -t, -1.0f);
}

//------------------------------------------------------------------------------
/**
*/
UnpackMask(val : u32) f32x4
{
    return f32x4(val & 0x1, (val >> 1) & 0x1, (val >> 2) & 0x1, (val >> 3) & 0x1);
}

//------------------------------------------------------------------------------
/**
*/
entry_point
vsMain(
    binding(0) in position : f32x2,
    binding(1) in uv : f32x2,
    binding(2) in color : f32x4, 
    out UV : f32x2,
    out Color : f32x4) void
{
    const pos = f32x4(position, 0, 1);    
    var projPos = ImGUI.TextProjectionModel * pos;
    vertexExportCoordinates(projPos);
    Color = color;
    UV = uv;
}

//------------------------------------------------------------------------------
/** 
*/
entry_point
psMain(
    in UV : f32x2,
    in Color : f32x4) void
{
    var texColor : f32x4;
    var id, type, layer, mip, useAlpha, useRange, splat, pointFilter, tonemap : u32;
    UnpackTexture(ImGUI.PackedTextureInfo, id, type, mip, layer, useRange, useAlpha, splat, pointFilter, tonemap);
    if (pointFilter != 0)
    {
        if type == 0 { texColor = sample2DLod(id, PointTextureSampler, UV, mip); }
        else if type == 1 { texColor = sample2DArrayLod(id, PointTextureSampler, f32x3(UV, layer), mip); }
        else if type == 2
        {
            const size = textureGetSizeMip(Textures3D[id], mip);
            texColor = sample3DLod(id, PointTextureSampler, f32x3(UV, (f32(layer) + 0.5f) / f32(size.z)), mip);
        }
        else if type == 3 { texColor = sampleCubeLod(id, PointTextureSampler, CubeFaceDirection(UV, layer), f32(mip)); }
    }
    else
    {
        if type == 0 { texColor = sample2DLod(id, TextureSampler, UV, mip); }
        else if type == 1 { texColor = sample2DArrayLod(id, TextureSampler, f32x3(UV, layer), mip); }
        else if type == 2
        {
            const size = textureGetSizeMip(Textures3D[id], mip);
            texColor = sample3DLod(id, TextureSampler, f32x3(UV, (f32(layer) + 0.5f) / f32(size.z)), mip);
        }
        else if type == 3 { texColor = sampleCubeLod(id, TextureSampler, CubeFaceDirection(UV, layer), f32(mip)); }
    }
    
    if (useRange != 0)
    {
        texColor.rgb = (texColor.rgb - ImGUI.RangeMin) / (ImGUI.RangeMax - ImGUI.RangeMin);
    }

    // HDR values above 1 would clip to white, Reinhard maps them back below 1
    if (tonemap != 0)
    {
        const exposed = max(f32x3(0), texColor.rgb * ImGUI.Exposure);
        texColor.rgb = exposed / (exposed + f32x3(1.0f));
    }

    if useAlpha == 0 { texColor.a = 1.0f; }
    if splat == 1u { texColor.rgba = f32x4(f32x3(texColor.r), 1.0f); }
        
    const mask = UnpackMask(ImGUI.ColorMask);

    // Since we are using sRGB output, remember to degamma
    pixelExportColor(Color * texColor * mask, 0);
}


//------------------------------------------------------------------------------
/**
*/
@Mask("Static")
program Default
{
    VertexShader = vsMain;
    PixelShader = psMain;
    RenderState = TextState;
};
